<Page
    x:Class="BookLibrary.Views.AddBookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BookLibrary.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <StackPanel Padding="36" Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="Agregar Nuevo Libro" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBox Header="Titulo del Libro" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ingrese el título del libro"/>
        <TextBox Header="Autor" Text="{x:Bind ViewModel.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ingrese el nombre del autor"/>

        <StackPanel Spacing="8">
            <TextBlock Text="Archivo PDF" Style="{ThemeResource BodyTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Buscar PDF..." Click="SelectPdf_Click"/>
                <TextBlock Text="{x:Bind ViewModel.PdfPath, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>

        <Button Content="Guardar Libro" Command="{x:Bind ViewModel.SaveBookCommand}" Style="{ThemeResource AccentButtonStyle}" MinWidth="120" Margin="0,16,0,0"/>
    </StackPanel>
</Page>
